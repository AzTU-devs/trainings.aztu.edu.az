# trainings.aztu.edu.az — environment template
#
# Copy to .env.local for local development, or to .env for a docker compose deploy
# (docker-compose.prod.yml reads .env for both build args and runtime env).
#
# NEXT_PUBLIC_* are inlined into the CLIENT bundle by `next build`. Setting one
# with `docker run -e` does nothing — the bundle already has the old value baked
# in. They must be passed as `--build-arg`, which means one image per environment.
# Everything under "Server-only" is read per request, so a restart is enough.

# --- Public (build-time) ---------------------------------------------------
# Browser -> backend origin.
NEXT_PUBLIC_API_URL=http://localhost:8080
# STOMP/WebSocket endpoint for live notifications (wss:// in production).
# This is used verbatim as the broker URL and must match the server's registered
# endpoint, which is exactly `/ws` — no suffix. Leave it unset to have it derived
# from NEXT_PUBLIC_API_URL instead.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# Canonical origin — used for metadata, sitemap.ts and robots.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tutor/admin portal. Non-student accounts are redirected here after login.
NEXT_PUBLIC_PORTAL_URL=http://localhost:3001
# Fallback when locale negotiation finds no match. Production uses `az`.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Server-only (runtime) -------------------------------------------------
# Backend URL for server components and the proxy's token refresh. Inside a
# container network this is the service name (http://backend:8080); under host
# networking it is http://127.0.0.1:8080. Falls back to NEXT_PUBLIC_API_URL.
INTERNAL_API_URL=http://localhost:8080

# Shared secret for on-demand revalidation. Generate with:
#   openssl rand -base64 32
REVALIDATE_SECRET=

# Only needed when running more than one replica: Next encrypts Server Function
# closures with a per-build key, so without a stable shared key a payload
# encrypted by one instance fails to decrypt on another ("Failed to find Server
# Action"). Use the SAME value for every replica of a release. Generate with:
#   openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Port the server listens on (the image defaults to 3000).
PORT=3000

# Optional error reporting.
SENTRY_DSN=
